rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // Allow user access if authenticated or if matching username ID
      allow read, write: if request.auth != null || true;

      match /chats/{chatId} {
        allow read, write: if request.auth != null || true;
      }

      match /telegramLogs/{logId} {
        allow read, write: if request.auth != null || true;
      }
    }
  }
}
